# Application
APP_NAME=indian-stock-ai
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+psycopg://stockai:stockai@localhost:5432/stockai
POSTGRES_USER=stockai
POSTGRES_PASSWORD=stockai
POSTGRES_DB=stockai

# Redis
REDIS_URL=redis://localhost:6379/0

# Data providers: csv_sample | yahoo
MARKET_DATA_PROVIDER=csv_sample
YAHOO_ENABLED=false
SAMPLE_DATA_DIR=/data/sample

# Universe
UNIVERSE_CONFIG=/config/universe.yaml
MIN_AVG_DAILY_VOLUME=500000
MIN_PRICE_HISTORY_DAYS=252

# Portfolio / risk
INITIAL_CAPITAL=1000000
MAX_RISK_PER_TRADE=0.005
MAX_POSITION_SIZE=0.05
MAX_SECTOR_EXPOSURE=0.20
MAX_OPEN_POSITIONS=20
MAX_PORTFOLIO_DRAWDOWN=0.15
DAILY_LOSS_LIMIT=0.02

# Transaction costs
TRANSACTION_COST_CONFIG=/config/transaction_costs.yaml
SLIPPAGE_BPS=5
SPREAD_BPS=5

# ML
MODEL_ARTIFACT_DIR=/artifacts/models
DEFAULT_PREDICTION_HORIZONS=1,3,5,10,20
RANDOM_SEED=42

# Auth
AUTH_ENABLED=false
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate limiting
RATE_LIMIT_PER_MINUTE=120

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
