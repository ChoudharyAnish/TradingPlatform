# Environment
# NOTE: .env is tracked in this repo by request (demo defaults only).
# Do NOT put real API keys or production secrets here — use .env.local instead.
.env.local
.env.*.local
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.ipynb_checkpoints/

# ML artifacts (keep structure)
artifacts/**
!artifacts/.gitkeep
backend/artifacts/**
!backend/artifacts/.gitkeep
models_store/**
!models_store/.gitkeep

# Data (keep sample)
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep
!data/sample/**

# Node
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/
*.tsbuildinfo

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
logs/
